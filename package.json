{
  "name": "whatsapp-langgraph-audio-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --no-warnings src/entrypoints/pipeline-cli.js",
    "start:legacy": "node src/legacy/old/orquestracao.js",
    "monitor": "node src/legacy/old/monitor-whatsapp-simulado.js",
    "monitor:audios": "node src/legacy/old/monitor-whatsapp-simulado.js ./data/conversa-demo-audios.json",
    "rag": "node --no-warnings src/legacy/old/rag.js",
    "fraude": "node --no-warnings src/legacy/old/fraude-rag.js",
    "fraude:recentes": "node --no-warnings src/legacy/old/fraude-rag.js --recentes",
    "pipeline:offline": "node --no-warnings src/entrypoints/pipeline-cli.js",
    "test": "node --test",
    "dev": "node --watch src/entrypoints/pipeline-cli.js",
    "observability:emit": "node scripts/agent-observability/emit-event.mjs",
    "observability:read-beads": "node scripts/agent-observability/read-beads.mjs",
    "observability:validate": "node scripts/agent-observability/validate-events.mjs",
    "preto-velho": "node scripts/preto-velho/launch.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.62.0",
    "@huggingface/inference": "^4.13.25",
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.4.9",
    "dotenv": "^16.4.7"
  }
